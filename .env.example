# Local demo runs without provider credentials. Never use demo mode to accept real bookings.
APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BRAND_NAME=Conversation Studio
HOST_NAME=Your host
SUPPORT_EMAIL=
GST_STATUS=unconfirmed
GSTIN=
ADMIN_EMAILS=
# Optional, local demo admin only. Generate a random password of at least 16 characters.
DEMO_ADMIN_SECRET=

# Required in live mode. No service-role key or secrets may be NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
HMS_ACCESS_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID_VIDEO=
HMS_TEMPLATE_ID_AUDIO=
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters. Keep separate from other keys.
BOOKING_LINK_ENCRYPTION_KEY=

# Optional WhatsApp; enable only after template approval and opt-in handling are ready.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
